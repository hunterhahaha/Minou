{
  "name": "nicode",
  "version": "0.1.0",
  "private": true,
  "description": "NiCode V1 — 本地运行的 Coding Agent Runtime",
  "main": "dist/src/main/electron-main.js",
  "bin": {
    "nicode": "dist/src/cli/main.js"
  },
  "scripts": {
    "dev": "tsc && node scripts/dev-electron.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.renderer.json",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "build:cli": "tsc",
    "cli": "node dist/src/cli/main.js",
    "test:cli": "npm run build:cli && node --experimental-strip-types test/cli/protocol.test.ts && node --experimental-strip-types test/cli/run.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@jmespath-community/jmespath": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pierre/diffs": "1.0.11",
    "@pierre/trees": "1.0.0-beta.6",
    "@tabler/icons-react": "^3.48.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "node-pty": "1.1.0",
    "openai": "^7.15.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "undici": "^8.10.2",
    "wink-bm25-text-search": "^3.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "electron": "^44.4.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
