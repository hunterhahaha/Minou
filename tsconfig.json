{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true,

    // 源码里的相对导入带 .ts 后缀：这样 Node 能直接运行（含测试），
    // 同时由 rewriteRelativeImportExtensions 在产出时改写成 .js。
    // 两个选项需成对出现，详见 README「工程配置」。
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "runtime/*/src/**/*.ts"]
}
